[org/gnome/settings-daemon/plugins/power]
# Power button behavior:
#   Short press (<2s) → lock screen (handled by logind HandlePowerKey=lock)
#   Long press (2-7s) → GNOME interactive shutdown dialog (logind passes
#     the long press to the session via HandlePowerKeyLongPress=ignore)
#   Very long press (>7s) → PMIC S2 hardware reset (unavoidable)
# s2idle suspend is not recoverable on piano yet, so we use lock instead.
power-button-action='interactive'
